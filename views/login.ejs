<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Acesso Master — Controle de Bots</title>
  <style>
    body { font-family: Arial, sans-serif; background: #0f172a; color: #fff; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
    .box { background: #1e293b; padding: 30px; border-radius: 10px; width: 320px; box-shadow: 0 4px 20px rgba(0,0,0,0.4); }
    input { width: 100%; padding: 10px; margin: 12px 0; border-radius: 5px; border: none; box-sizing: border-box; }
    button { width: 100%; padding: 10px; background: #22c55e; color: #fff; border: none; border-radius: 5px; font-weight: bold; cursor: pointer; }
    .err { color: #f87171; font-size: 14px; }
  </style>
</head>
<body>
  <div class="box">
    <h2>🔐 Painel Master</h2>
    <% if (error) { %><p class="err"><%= error %></p><% } %>
    <form method="POST" action="/login">
      <input type="password" name="password" placeholder="Digite sua senha Master" required />
      <button type="submit">Entrar no Sistema</button>
    </form>
  </div>
</body>
</html>