# Runtime profile: all | web | bot
APP_ROLE=all

# Discord
DISCORD_TOKEN=
CLIENT_ID=
MASTER_ID=
REGISTER_COMMANDS=false

# Turso / libSQL
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Painel web
MASTER_PASSWORD=
SESSION_SECRET=
NODE_ENV=production
PORT=8080

# Discord OAuth do portal do lojista (use o mesmo CLIENT_ID da aplicação Discord)
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://SEU-DOMINIO/auth/discord/callback

# Mercado Pago OAuth (aplicação do marketplace)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=https://SEU-DOMINIO/oauth/mercadopago/callback
MP_TOKEN_ENCRYPTION_KEY=
MP_WEBHOOK_SECRET=
PUBLIC_BASE_URL=https://SEU-DOMINIO
